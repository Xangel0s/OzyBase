# OzyBase Configuration Template
# Copy this file and customize for your environment
# For local development, modify values marked with "YOUR-"

# ============= DEPLOYMENT PROFILE =============
OZY_DEPLOYMENT_PROFILE=single_project_local
PORT=8090
DEBUG=true

# ============= SITE & DOMAIN CONFIGURATION =============
# For local development:
SITE_URL=http://127.0.0.1:8090
APP_DOMAIN=localhost
ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,http://127.0.0.1:5342,http://localhost:5342

# For production:
# SITE_URL=https://api.example.com
# APP_DOMAIN=example.com
# ALLOWED_ORIGINS=https://app.example.com,https://api.example.com

# ============= SECURITY - AUTHENTICATION =============
# Generate random secrets:
# Linux/Mac: openssl rand -base64 48
# PowerShell: [Convert]::ToBase64String([System.Random]::new().GetBytes(48))

JWT_SECRET=YOUR-64-BYTE-RANDOM-SECRET-HERE-MUST-BE-UNIQUE-AND-SECURE-MIN-32-CHARS
ANON_KEY=YOUR-LONG-RANDOM-ANONYMOUS-KEY-FOR-PUBLIC-API-CLIENTS
SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY-FOR-SERVER-TO-SERVER-INTEGRATION

# Optional: For key rotation
ANON_KEY_PREVIOUS=
SERVICE_ROLE_KEY_PREVIOUS=
STATIC_KEY_GRACE_UNTIL=
API_KEY_ROTATION_GRACE_MINUTES=15

# ============= DATABASE - POSTGRESQL =============
# Default for Docker Compose:
DB_USER=postgres
DB_PASSWORD=YOUR-STRONG-PASSWORD-FOR-DATABASE
DB_NAME=ozybase
DB_SSLMODE=disable
DB_HOST=localhost
DB_PORT=5432

# Complete DATABASE_URL (used if provided, else built from DB_* vars)
DATABASE_URL=postgres://postgres:YOUR-STRONG-PASSWORD-FOR-DATABASE@localhost:5432/ozybase?sslmode=disable

# Optional: Connection pooler for production
# Example with PgBouncer or Supavisor
DB_POOLER_URL=

# ============= RATE LIMITING =============
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
BODY_LIMIT=10M
OZY_SQL_EDITOR_MAX_ROWS=1000

# ============= EMAIL / SMTP (OPTIONAL) =============
# Leave empty to use console-only LogMailer (logs to stdout)
# Required for: password resets, invitations, notifications

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# Example configurations:
# Gmail (less secure apps):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-app-password
#   SMTP_FROM=noreply@example.com

# AWS SES:
#   SMTP_HOST=email-smtp.region.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=your-ses-username
#   SMTP_PASSWORD=your-ses-password
#   SMTP_FROM=verified-email@yourdomain.com

# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.your-api-key
#   SMTP_FROM=noreply@yourdomain.com

# Resend:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_your-api-key
#   SMTP_FROM=onboarding@resend.dev

# ============= STORAGE =============
# Default: local filesystem
OZY_STORAGE_PROVIDER=local
OZY_STORAGE_PATH=/app/data/storage

# Optional: MinIO/S3-compatible storage
# OZY_STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=YOUR-AWS-ACCESS-KEY
# S3_SECRET_KEY=YOUR-AWS-SECRET-KEY
# S3_BUCKET=ozybase-storage
# S3_USE_SSL=true

# ============= REALTIME (OPTIONAL) =============
# Default: in-process (single instance)
# For multi-instance deployments, use Redis

# OZY_REALTIME_BROKER=redis
# REDIS_URL=redis://localhost:6379
# Or:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============= SECURITY FLAGS =============
# Set to true after replacing all placeholder values with production values
OZY_STRICT_SECURITY=true

# ============= ADMIN INITIALIZATION (OPTIONAL) =============
# Only used on first startup if no admin exists
# If not provided, setup wizard will prompt for admin credentials
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=YOUR-INITIAL-ADMIN-PASSWORD

# ============= DEVELOPMENT FLAGS =============
# Only for local development, disable in production
DEBUG=false

# ============= MIGRATIONS & INSTALLATION =============
# Auto-generation and storage of secrets if not provided:
# - If JWT_SECRET empty, auto-generates and stores in .ozy_secret
# - If ANON_KEY empty, auto-generates and stores in .ozy_anon_key
# - If SERVICE_ROLE_KEY empty, auto-generates and stores in .ozy_service_role_key
# - If ALLOWED_ORIGINS empty, derives safe defaults from SITE_URL/APP_DOMAIN

OZY_SKIP_MIGRATIONS_SEED=false

# ============= NGINX / REVERSE PROXY (OPTIONAL) =============
# Used by docker-compose.coolify.yml and deploy/nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============= ADDITIONAL SETTINGS =============
# Application name (optional, used in UI/emails)
APP_NAME=OzyBase

# Support email (optional, for support links in UI)
SUPPORT_EMAIL=support@example.com

# Documentation URL (optional)
DOCS_URL=https://docs.ozybase.com

# ============= DOCKER IMAGE (for pull from registry) =============
OZYBASE_IMAGE=ozybase:local

# For production from GHCR:
# OZYBASE_IMAGE=ghcr.io/xangel0s/ozybase:v1.2.3

# ============= END OF CONFIGURATION =============
